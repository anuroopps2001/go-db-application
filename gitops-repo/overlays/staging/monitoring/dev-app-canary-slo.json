            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  (\n    sum by (version) (rate(http_requests_total{version!=\"\", path!~\"/healthz|/ready\"}[5m]))\n    / \n    ignoring(version) group_left() sum(rate(http_requests_total{version!=\"\", path!~\"/healthz|/ready\"}[5m]))\n  ) * 100\n) and on() (sum(irate(http_requests_total[30s])) > 0.5) or (sum by (version) (http_requests_total * 0))\n",
