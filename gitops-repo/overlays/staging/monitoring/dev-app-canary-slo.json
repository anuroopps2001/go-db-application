          "editorMode": "code",
          "expr": "(\n  sum by (version) (rate(http_requests_total{status=~\"4.*|5.*\"}[1m]))\n  /\n  sum by (version) (rate(http_requests_total[1m]))\n) * 100 or (sum by (version) (http_requests_total * 0))",
